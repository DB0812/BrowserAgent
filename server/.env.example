# ─────────────────────────────────────────────────────────────────────────────
# Privacy-Preserving Browser Agent — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.

# ── LLM PROVIDER ─────────────────────────────────────────────────────────────
# Set the provider to use: "gemini" | "openai" | "anthropic" | "mock"
LLM_PROVIDER=gemini

# Google Gemini (default, recommended — free tier available)
# Get key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# OpenAI (optional)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (optional)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── MODEL SELECTION ───────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-20240307

# ── SERVER ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ── DATABASE ─────────────────────────────────────────────────────────────────
# SQLite for hackathon (swap to postgresql+asyncpg://... for production)
DATABASE_URL=sqlite+aiosqlite:///./privacy_agent.db

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,chrome-extension://
